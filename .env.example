# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app

# --- WhatsApp Cloud API (Meta for Developers -> your app -> WhatsApp -> API Setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; type the same one in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=autoveer-verify
# App settings -> Basic -> App secret. Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Numbers that get a WhatsApp alert for every new lead (comma separated).
# Use YOUR OWN number while testing.
STAFF_NUMBERS=
